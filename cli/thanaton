        elif args.action == "close":
            res = sbx.close_port(args.port)
            print(f"[+] {res.get('message', 'Port forwarding listener closed.')}")
    except Exception as e:
        print(f"[!] Port forwarding operation failed: {e}", file=sys.stderr)
